{
  "name": "fire-ash-modifier-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Herramientas reproducibles de auditoría y referencia visual para Fire Ash Modifier.",
  "scripts": {
    "test": "node web/js/marshal.test.mjs && node web/js/integration.test.mjs && node tools/external_authoring.test.mjs && node tools/tone_safety.test.mjs && node tools/package_integrity.test.mjs",
    "test:ui": "node --experimental-vm-modules web/js/ui.test.mjs",
    "verify:tier2:macro04": "node tools/apply_tier2_routes.mjs --input content/atlas_tier2_blueprints_macro04.json --backup atlas_tier2_macro04_originals --verify",
    "verify:tier2:macro05": "node tools/apply_tier2_routes.mjs --input content/atlas_tier2_blueprints_macro05.json --backup atlas_tier2_macro05_originals --verify",
    "verify:tier2:macro06": "node tools/apply_tier2_routes.mjs --input content/atlas_tier2_blueprints_macro06.json --backup atlas_tier2_macro06_originals --verify",
    "verify:tier2:macro07": "node tools/apply_tier2_routes.mjs --input content/atlas_tier2_blueprints_macro07.json --backup atlas_tier2_macro07_originals --verify",
    "verify:tier2:macro04-05": "npm run verify:tier2:macro04 && npm run verify:tier2:macro05",
    "verify:tier2:macro06-07": "npm run verify:tier2:macro06 && npm run verify:tier2:macro07",
    "verify:tier3:rules": "node tools/apply_atlas_tier3_rules.mjs --verify",
    "verify:grandeur:bag": "node tools/apply_grandeur_bag_freedom.mjs --verify",
    "verify:abra:tower": "node tools/apply_emergency_abra_and_free_tower.mjs --verify",
    "verify:oak:hub": "node tools/apply_oak_lab_postgame_hub.mjs --verify",
    "verify:atlas": "npm run verify:tier2:macro04-05 && npm run verify:tier2:macro06-07 && npm run verify:tier3:rules",
    "render:atlas:macro02": "node tools/render_atlas_visual_reference.mjs --macro 02",
    "render:tier2:macro03": "node tools/render_atlas_visual_reference.mjs --tier2 content/atlas_tier2_blueprints_macro03.json --backup pokemon_fire_ash/PokeModBackups/atlas_tier2_macro03_originals --before docs/referencia_tier2_macro03_antes.png --after docs/referencia_tier2_macro03_despues.png",
    "render:tier2:macro04": "node tools/render_atlas_visual_reference.mjs --tier2 content/atlas_tier2_blueprints_macro04.json --backup pokemon_fire_ash/PokeModBackups/atlas_tier2_macro04_originals --before docs/referencia_tier2_macro04_antes.png --after docs/referencia_tier2_macro04_despues.png",
    "render:tier2:macro05": "node tools/render_atlas_visual_reference.mjs --tier2 content/atlas_tier2_blueprints_macro05.json --backup pokemon_fire_ash/PokeModBackups/atlas_tier2_macro05_originals --before docs/referencia_tier2_macro05_antes.png --after docs/referencia_tier2_macro05_despues.png",
    "verify:defeats": "node tools/audit_defeat_persistence.mjs",
    "verify:multiverse": "node tools/apply_multiverse_creepypasta.mjs --verify",
    "verify:event-collision": "node tools/apply_event_collision_fix.mjs --verify",
    "verify:save-path": "node tools/apply_save_path_fix.mjs --verify",
    "create:multiverse": "node tools/create_multiverse_creepypasta.mjs",
    "create:wild": "node tools/create_wild_zones.mjs",
    "verify:wild": "node tools/apply_wild_zones.mjs --verify",
    "rebuild:monte_silver": "node tools/apply_monte_silver_rebuild.mjs",
    "verify:monte_silver": "node tools/apply_monte_silver_rebuild.mjs --verify",
    "rebuild:isla_espejo": "node tools/apply_isla_espejo_maps_rebuild.mjs",
    "verify:isla_espejo": "node tools/apply_isla_espejo_maps_rebuild.mjs --verify",
    "rebuild:ruta_de_dios": "node tools/apply_la_ruta_de_dios.mjs",
    "verify:ruta_de_dios": "node tools/apply_la_ruta_de_dios.mjs --verify",
    "sync:ruta_de_dios:package": "node tools/sync_ruta_de_dios_package.mjs",
    "build:package": "node tools/build_direct_package.mjs",
    "verify:package": "node tools/build_direct_package.mjs --verify",
    "verify:ruta_de_dios:package": "node tools/sync_ruta_de_dios_package.mjs --verify",
    "create:map-reference": "node --expose-gc tools/generate_map_reference_package.mjs",
    "verify:map-reference": "node tools/generate_map_reference_package.mjs --verify",
    "dn:check": "node tools/dn_ingest_reference.mjs --check",
    "dn:ingest": "node tools/dn_ingest_reference.mjs",
    "dn:fixtures": "node tools/dn_ingest_reference.mjs --fixtures",
    "dn:selftest": "node tools/dn_ingest_reference.mjs --selftest",
    "dn:tiles": "node tools/dn_extract_tileset.mjs",
    "dn:tiles:selftest": "node tools/dn_extract_tileset.mjs --selftest",
    "verify:arceus-portal": "node tools/apply_arceus_portal_recovery.mjs --verify",
    "verify:tone-safety": "node tools/apply_tone_safety_fix.mjs --verify",
    "verify:transition-safety": "node tools/apply_transition_safety_fix.mjs --verify",
    "verify:all": "npm test && npm run test:ui && npm run verify:atlas && npm run verify:grandeur:bag && npm run verify:abra:tower && npm run verify:oak:hub && npm run verify:defeats && npm run verify:multiverse && npm run verify:event-collision && npm run verify:save-path && npm run verify:wild && npm run verify:monte_silver && npm run verify:isla_espejo && npm run verify:ruta_de_dios && npm run verify:ruta_de_dios:package && npm run verify:map-reference && npm run verify:arceus-portal && npm run verify:tone-safety && npm run verify:transition-safety"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "jsdom": "27.0.0"
  }
}
