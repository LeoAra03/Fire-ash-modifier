# Dimensional Nightmare: los recortes se regeneran con `npm run dn:ingest`
# y los mosaicos de terceros no se redistribuyen en el repo
reference/dimensional_nightmare/recursos/
reference/dimensional_nightmare/slices/
reference/dimensional_nightmare/_fixtures/
reference/dimensional_nightmare/tilesets/
reference/dimensional_nightmare/index.json
reference/dimensional_nightmare/selftest.png
content/dimensional_nightmare_tiles.json
content/dimensional_nightmare_tiles_2x.json
reference/dimensional_nightmare/preview_*.png
docs/dn_referencia/detalle/
docs/dn_referencia/recreacion/detalle/
Mapas/*
!Mapas/crepypasta/
Mapas/crepypasta/*
!Mapas/crepypasta/README.md

# Overlays de pasajes por mapa: se regeneran con `npm run dn:pasajes:*` (--render).
# La evidencia versionada son las hojas por episodio de docs/dn_referencia/lotes/.
docs/dn_referencia/pasajes/

# Arte conceptual sin procesar (pesado; los assets derivados sí se versionan)
reference/pokegods/concept/
reference/pokegods/concepto/

# ROMs invitadas y su material extraído (no se versiona)
roms pokemon/

# Paquete TIMPS Swarm: se guarda el zip, no el contenido descomprimido
agents/timps-swarm-main/

# Referencia de Atlas Mil (generada por tools/atlas_ingest_reference.mjs)
reference/atlas/

# Extracciones locales del toolkit de terceros: se regeneran desde los ZIP/RAR fuente.
# Solo se versionan el índice y la guía; código fuente duplicado y assets quedan fuera.
/toolkit/*
!/toolkit/README.md
!/toolkit/INDICE_HERRAMIENTAS.json
/temporal_extraccion/
